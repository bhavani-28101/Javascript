/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number[]}
 */
var twoSum = function(nums, target) {
    let dict={};
    let res=[];
    for(let i=0;i<nums.length;i++){
        let req=target-nums[i];
        if(req in dict){
            res.push(i,dict[req]);
            break;
        }
        dict[nums[i]]=i;
    }
    return res;
};

/**
 * @param {number[]} nums
 * @return {void} Do not return anything, modify nums in-place instead.
 */
var sortColors = function(nums) {
    if(nums.length<=1){
        return nums;
    }
    let freq=[0,0,0];
    for(let i=0;i<nums.length;i++){
        freq[nums[i]]+=1;
    }
    let k=0;
    for(let r=0;r<3;r++){
        let count=freq[r];
        while(count>0){
            nums[k]=r;
            k+=1;
            count-=1;
        }
    }
    return nums;
};

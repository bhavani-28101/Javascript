var subsetsWithDup = function(nums) {
    nums.sort((a, b) => a - b);

    let res = [];
    let subset = [];

    function backtrack(index) {
        res.push([...subset]);

        for (let i = index; i < nums.length; i++) {
            // Skip duplicates at the same recursion level
            if (i > index && nums[i] === nums[i - 1]) {
                continue;
            }

            subset.push(nums[i]);

            backtrack(i + 1);

            subset.pop();
        }
    }

    backtrack(0);
    return res;
};

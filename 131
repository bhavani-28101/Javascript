var partition = function(s) {
    let result = [];
    let path = [];

    function backtrack(start) {
        if (start === s.length) {
            result.push([...path]);
            return;
        }

        for (let end = start; end < s.length; end++) {
            let sub = s.substring(start, end + 1);

            if (isPalindrome(sub)) {
                path.push(sub);
                backtrack(end + 1);
                path.pop();
            }
        }
    }

    function isPalindrome(str) {
        let left = 0;
        let right = str.length - 1;

        while (left < right) {
            if (str[left] !== str[right]) {
                return false;
            }
            left++;
            right--;
        }

        return true;
    }

    backtrack(0);
    return result;
};

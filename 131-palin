var partition = function(s) {
    let res = [];
    let curr = [];

    function bt(start) {
        if (start === s.length) {
            res.push([...curr]);
            return;
        }

        for (let i = start; i < s.length; i++) {
            let sub = s.substring(start, i + 1);

            if (isPalindrome(sub)) {
                curr.push(sub);
                bt(i + 1);
                curr.pop();
            }
        }
    }

    function isPalindrome(str) {
        let left = 0;
        let right = str.length - 1;

        while (left < right) {
            if (str[left] !== str[right]) {
                return false;
            }
            left++;
            right--;
        }

        return true;
    }

    bt(0);
    return res;
};

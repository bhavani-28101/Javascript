/**
 * @param {number} x
 * @return {number}
 */
var mySqrt = function(x) {
    let low=1;
    let high=x;
    let mid;
    while(low<=high){
        mid=Math.floor(low+(high-low)/2);
        if(mid*mid==x){
            return mid;
        }
        else if(mid*mid>x){
            high=mid-1;
        }
        else{
            low=mid+1;
        }

    }
    return high;
    
};
